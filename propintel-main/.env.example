# Copy this file to .env.local and fill in real values.
# Neither variable is required for the app to run — both features degrade
# gracefully to an honest "not configured" state when absent.

# Google Maps JavaScript API key. Without this, the property location panel
# shows a placeholder instead of a live map (see mapService.hasGoogleMapsKey).
VITE_GOOGLE_MAPS_API_KEY=

# Gemini API key. Without this, aiService falls back to deterministic mock
# reasoning derived from each property's own data (see aiService.hasGeminiKey).
# In production this should be read by a backend/proxy, never the browser.
VITE_GEMINI_API_KEY=
